public void createCourseAndClass(String name, String description) {
    // code here
    apxi__Course__c course = new apxi__Course__c();
    course.Name = name;
    if(description != null) course.apxio__Course_Details__c = description;
    insert course;
    apxio__Class__c newClass = new apxio__Class__c();
    newClass.apxi__Course__c = course.Id;
    newClass.Name = name;
    newClass.apxio__Description__c = description.abbreviate(255);
    insert newClass;
    return;
}